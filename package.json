{
  "name": "studenthub-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run build && node tools/fixtures/src/web-preview.mjs",
    "test:web": "node --test dist/apps/gateway/test/web-ui.test.js dist/apps/gateway/test/context-navigation.test.js dist/apps/gateway/test/company-directory.test.js && node apps/gateway/test/context-navigation-mutations.mjs && node apps/gateway/test/company-directory-mutations.mjs",
    "build": "npm run build -w @bawes/actor-assertion && npm run build -w @studenthub/contracts && npm run build -w @studenthub/login-contract && npm run build -w @studenthub/source-connection-contract && npm run build -w @studenthub/safe-write-contract && npm run build -w @studenthub/idempotency-contract && npm run build -w @studenthub/reference-catalogue && npm run build -w @studenthub/profile-records && npm run build -w @studenthub/pay-contracts && npm run build -w @studenthub/db && npm run build -w @studenthub/profile && npm run build -w @studenthub/organizations && tsc -p tsconfig.build.json",
    "start:gateway": "node dist/apps/gateway/src/index.js",
    "start:worker": "node dist/apps/worker/src/index.js",
    "test": "npm run build && node tools/test-runner/run.mjs",
    "test:db": "npm run build && node tools/test-runner/run.mjs --db",
    "benchmark:search": "npm run build && node dist/tools/search-bakeoff/src/run.js",
    "dry-run:import": "npm run build && node dist/tools/legacy-import/src/dry-run.js",
    "typecheck": "npm run build -w @bawes/actor-assertion && npm run build -w @studenthub/contracts && npm run build -w @studenthub/login-contract && npm run build -w @studenthub/source-connection-contract && npm run build -w @studenthub/safe-write-contract && npm run build -w @studenthub/idempotency-contract && npm run build -w @studenthub/reference-catalogue && npm run build -w @studenthub/profile-records && npm run build -w @studenthub/pay-contracts && npm run build -w @studenthub/db && npm run build -w @studenthub/profile && npm run build -w @studenthub/organizations && tsc --noEmit",
    "test:catalogue:mutations": "node packages/reference-catalogue/test/mutations.mjs",
    "test:profile-records:mutations": "node packages/profile-records/test/mutations.mjs",
    "test:pay-contracts:mutations": "node packages/pay-contracts/test/mutations.mjs",
    "test:assertion": "vitest run packages/actor-assertion/test",
    "test:coordinator": "node --test .github/coordinator/test/*.test.mjs .github/coordinator/service/test/*.test.mjs",
    "test:idempotency:mutations": "node packages/idempotency-contract/test/mutations.mjs",
    "test:profile:mutations": "node packages/profile/test/mutations.mjs",
    "test:organizations:mutations": "node packages/organizations/test/mutations.mjs",
    "test:organization-profile:mutations": "node packages/organizations/test/profile-writes-mutations.mjs",
    "test:organization-status:mutations": "node packages/organizations/test/status-writes-mutations.mjs",
    "test:organization-status-batch:mutations": "node packages/organizations/test/status-batch-reads-mutations.mjs",
    "test:organization-status-events:mutations": "node packages/organizations/test/status-events-mutations.mjs",
    "test:organization-commercial-terms:mutations": "node packages/organizations/test/commercial-terms-writes-mutations.mjs",
    "test:organization-documents:mutations": "node apps/gateway/test/organization-documents-mutations.mjs",
    "test:organization-directory:mutations": "node packages/organizations/test/directory-mutations.mjs",
    "test:organization-approved-to-hire:mutations": "node packages/organizations/test/approved-to-hire-writes-mutations.mjs",
    "test:organization-notes:mutations": "node packages/organizations/test/organization-notes-mutations.mjs",
    "test:pay-contract-writes:mutations": "node packages/pay-contracts/test/contract-writes-mutations.mjs",
    "test:pay-contract-changes:mutations": "node packages/pay-contracts/test/contract-changes-mutations.mjs",
    "test:pay-contract-reads:mutations": "node packages/pay-contracts/test/contract-reads-mutations.mjs",
    "test:deployment": "node --test deploy/coolify/test/*.test.mjs",
    "test:search-integration": "npm run build && node --test dist/packages/search/test/typesense-integration.test.js",
    "migrate": "npm run migrate -w @studenthub/db",
    "db:migrate": "npm run migrate -w @studenthub/db",
    "db:bootstrap:admin": "npm run bootstrap:admin -w @studenthub/db",
    "test:documents": "node --test packages/private-documents/test/private-documents.test.mjs",
    "test:documents:mutations": "node packages/private-documents/test/mutations.mjs",
    "test:documents:hardening": "node --test packages/private-documents/test/hardening.test.mjs",
    "test:documents:hardening:mutations": "node packages/private-documents/test/hardening-mutations.mjs",
    "test:documents:deletion:mutations": "node packages/private-documents/test/organization-deletion-mutations.mjs",
    "test:observability": "node --test dist/packages/observability/test/observability.test.js",
    "test:observability:mutations": "node packages/observability/test/mutations.mjs",
    "exercise:observability": "node tools/observability/synthetic-exercise.mjs",
    "test:documents:r2:postgres": "node --test packages/private-documents/test/r2-postgres.test.mjs",
    "test:documents:r2": "node --test packages/private-documents/test/r2-lifecycle.test.mjs",
    "test:documents:lifecycle:mutations": "node packages/private-documents/test/candidate-lifecycle-mutations.mjs",
    "test:documents:lifecycle": "node --test packages/private-documents/test/candidate-lifecycle.test.mjs",
    "test:catalogue-bank-payment-details:mutations": "node packages/reference-catalogue/test/bank-payment-details-mutations.mjs",
    "test:catalogue-currency-details:mutations": "node packages/reference-catalogue/test/currency-details-mutations.mjs",
    "test:organization-note-types:mutations": "node packages/organizations/test/organization-note-types-mutations.mjs",
    "test:organization-brands:mutations": "node packages/organizations/test/organization-brands-mutations.mjs",
    "test:organization-stores:mutations": "node packages/organizations/test/organization-stores-mutations.mjs",
    "test:organization-creation:mutations": "node packages/organizations/test/organization-creation-mutations.mjs",
    "test:organization-account-manager:mutations": "node packages/organizations/test/account-manager-writes-mutations.mjs",
    "test:organization-deletion:mutations": "node packages/organizations/test/deletion-writes-mutations.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sentry/node": "10.74.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0"
  }
}
