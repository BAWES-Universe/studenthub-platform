{
  "name": "studenthub-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @studenthub/contracts && tsc -p tsconfig.build.json",
    "start:gateway": "node dist/apps/gateway/src/index.js",
    "start:worker": "node dist/apps/worker/src/index.js",
    "test": "npm run build && node --test \"dist/**/test/*.test.js\"",
    "typecheck": "npm run build -w @studenthub/contracts && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
