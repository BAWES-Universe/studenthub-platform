{
  "name": "studenthub-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:gateway": "node dist/apps/gateway/src/index.js",
    "start:worker": "node dist/apps/worker/src/index.js",
    "test": "npm run build && node --test dist/packages/contracts/test/contracts.test.js dist/apps/gateway/test/health.test.js dist/apps/worker/test/heartbeat.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
