{
  "name": "@studenthub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "import": "./dist/profile/index.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "import": "./dist/access/index.js"
    },
    "./catalogue": {
      "types": "./dist/catalogue/index.d.ts",
      "import": "./dist/catalogue/index.js"
    },
    "./organizations": {
      "types": "./dist/organizations/index.d.ts",
      "import": "./dist/organizations/index.js"
    },
    "./pay-contracts": {
      "types": "./dist/pay-contracts/index.d.ts",
      "import": "./dist/pay-contracts/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist/documents/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "npm run build && node dist/migrate.js",
    "bootstrap:admin": "npm run build && node dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@studenthub/contracts": "0.1.0",
    "@studenthub/login-contract": "1.0.0",
    "@studenthub/pay-contracts": "1.0.0",
    "@studenthub/profile-records": "1.0.0",
    "@studenthub/reference-catalogue": "1.0.0",
    "@studenthub/safe-write-contract": "3.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
