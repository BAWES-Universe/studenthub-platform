{
  "name": "@studenthub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "npm run build && node dist/migrate.js",
    "bootstrap:admin": "npm run build && node dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@studenthub/contracts": "0.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
