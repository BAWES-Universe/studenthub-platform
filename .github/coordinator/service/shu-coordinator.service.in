[Unit]
Description=StudentHub single coordinator writer
After=shu-supervisor.service
Requires=shu-supervisor.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@COORDINATOR_ENVIRONMENT_FILE@
LoadCredential=supervisor-transport:@SUPERVISOR_ENVIRONMENT_FILE@
Type=oneshot
WorkingDirectory=@WORKDIR@
Environment=ENABLE_DISPATCH=false
Environment=SHU_SUPERVISOR_SOCKET=@SUPERVISOR_SOCKET@
Environment=SHU_SUPERVISOR_STATE_DIR=@SUPERVISOR_STATE_DIR@
Environment=SHU_WORKSPACE_STATE_DIR=@WORKSPACE_STATE_DIR@
UMask=0077
ExecStart=@COORDINATOR_EXEC@
Restart=on-failure
RestartSec=10s
SuccessExitStatus=2
TimeoutStartSec=infinity
