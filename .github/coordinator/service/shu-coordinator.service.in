[Unit]
Description=StudentHub single coordinator writer
After=shu-supervisor.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
Environment=ENABLE_DISPATCH=false
UMask=0077
ExecStart=@COORDINATOR_EXEC@
Restart=on-failure
RestartSec=10s
SuccessExitStatus=2
TimeoutStartSec=infinity
