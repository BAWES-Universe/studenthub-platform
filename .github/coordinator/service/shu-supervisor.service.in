[Unit]
Description=StudentHub persistent supervisor
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@SUPERVISOR_ENVIRONMENT_FILE@
Type=notify
NotifyAccess=all
TimeoutStartSec=30s
WorkingDirectory=@WORKDIR@
Environment=ENABLE_DISPATCH=false
Environment=SHU_SUPERVISOR_ACTIVATION_FILE=/srv/shu/state/shu71-activation.json
Environment=SHU71_EVIDENCE_BROKER=true
Environment=SHU_SUPERVISOR_SOCKET=@SUPERVISOR_SOCKET@
Environment=SHU_SUPERVISOR_STATE_DIR=@SUPERVISOR_STATE_DIR@
UMask=0077
ExecStart=@SUPERVISOR_EXEC@
Restart=on-failure
RestartSec=5s
KillMode=process

[Install]
WantedBy=default.target
