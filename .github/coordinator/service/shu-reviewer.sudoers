# SHU-261: install as root:root 0440 only in a separately approved host window.
# SETENV applies only to this reviewed wrapper. The wrapper constructs a clean
# transient-service environment and forwards only CLAUDE_CODE_OAUTH_TOKEN.
Defaults!/usr/local/libexec/shu-reviewer-sandbox env_keep += "CLAUDE_CODE_OAUTH_TOKEN"
shu-coordinator ALL=(root) NOPASSWD:SETENV: /usr/local/libexec/shu-reviewer-sandbox *
